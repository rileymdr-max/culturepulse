// CulturePulse — Prisma Schema
// Run `npm run db:generate` after changes, `npm run db:push` to sync with DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth (NextAuth adapter tables) ─────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  onboardedAt    DateTime?
  /// Null until an admin approves the sign-up; unapproved users can't sign in.
  approvedAt     DateTime?
  /// Set while "Run all now" is running for this user; blocks overlapping runs.
  monitorRunStartedAt DateTime?

  // Billing
  plan                 String   @default("free") // free | starter | pro | agency
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  subscriptionStatus   String?  // active | trialing | past_due | canceled | incomplete
  currentPeriodEnd     DateTime?

  accounts            Account[]
  sessions            Session[]
  savedSearches       SavedSearch[]
  trackedCommunities  TrackedCommunity[]
  monitors            Monitor[]
  briefs              ContentBrief[]
  ownedWorkspaces     Workspace[]
  workspaceMemberships WorkspaceMember[]
  auditLogs           AuditLog[]
}

// ─── Saved Searches ──────────────────────────────────────────────────────────

model SavedSearch {
  id          String   @id @default(cuid())
  userId      String
  query       String
  platforms   String[] // e.g. ["reddit", "twitter"]
  label       String?  // optional display name
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Tracked Communities + History ───────────────────────────────────────────
// Users can track specific communities to observe metric changes over time.
// Each visit to a tracked community's detail page captures a new snapshot.

model TrackedCommunity {
  id            String              @id @default(cuid())
  userId        String
  communityId   String              // e.g. "reddit_gaming"
  communityName String
  platform      String
  createdAt     DateTime            @default(now())

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots     CommunitySnapshot[]

  @@unique([userId, communityId])
  @@index([userId])
}

model CommunitySnapshot {
  id                 String           @id @default(cuid())
  trackedCommunityId String
  communitySize      Int
  topTopics          String[]         // top 5 topic labels at time of capture
  topCategories      Json             // { label: string, volume: number }[]
  capturedAt         DateTime         @default(now())

  trackedCommunity   TrackedCommunity @relation(fields: [trackedCommunityId], references: [id], onDelete: Cascade)

  @@index([trackedCommunityId])
  @@index([capturedAt])
}

// ─── Community Cache ──────────────────────────────────────────────────────────
// Caches fetched community data to reduce API calls and support offline display.

model CommunityCache {
  id              String   @id @default(cuid())
  platform        String
  communityId     String
  communityName   String
  data            Json     // Stores the full unified CommunityData payload
  fetchedAt       DateTime @default(now())
  expiresAt       DateTime

  @@unique([platform, communityId])
  @@index([platform])
  @@index([expiresAt])
}

// ─── Subculture Library ───────────────────────────────────────────────────────
// Pre-built and AI-generated subculture profiles that power monitors.
// status: "draft" (AI-generated, unreviewed) | "approved" (human-reviewed) | "archived"

model Subculture {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @db.Text
  category    String
  status      String   @default("draft")

  // Original Speedbag quadrants (string arrays — Boolean query terms)
  keywords              String[]
  vernacular            String[]
  categoricalBehaviors  String[]

  // Rich structured fields
  moments               Json  // { name, timing, description }[]
  mediaSources          Json  // { name, type, description }[]
  icons                 Json  // { name, role, sentiment }[]
  platforms             Json  // { platform, engagement_level, content_formats }[]
  psychographics        Json  // { hero, villain, core_values, motivations }
  adjacentSubcultures   String[]
  brandFitSignals       Json  // { fit_industries, red_flags }

  // Live signal data (real scraped — per platform, with source labels)
  signalData      Json?

  // Demo visibility — admin can hide specific approved subcultures from demo sessions
  demoVisible     Boolean  @default(true)

  // Provenance
  generatedByAi   Boolean  @default(false)
  enrichedByApify Boolean  @default(false)
  reviewedBy      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  monitors  Monitor[]
  briefs    ContentBrief[]

  @@index([category])
  @@index([status])
}

// ─── Subculture Monitors ──────────────────────────────────────────────────────
// Scheduled monitors that capture postCount snapshots every 6 hours via cron.

model Monitor {
  id           String    @id @default(cuid())
  userId       String
  subcultureId String
  status       String    @default("active") // active | paused
  platforms    String[]  // any of MONITOR_PLATFORMS in lib/acceleration.ts
  lastRunAt             DateTime?
  lastBreakoutAlertAt   DateTime?
  // Demo curation — admin toggles which monitors appear in the demo sync
  demoVisible  Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subculture Subculture @relation(fields: [subcultureId], references: [id], onDelete: Cascade)
  snapshots  MonitorSnapshot[]

  @@unique([userId, subcultureId])
  @@index([userId])
  @@index([status])
}

// ─── Content Briefs ───────────────────────────────────────────────────────────
// AI-generated strategy documents from subculture + live signal context.

model ContentBrief {
  id           String  @id @default(cuid())
  userId       String
  subcultureId String
  monitorId    String?

  // Demo curation — admin toggles which briefs appear in the demo sync
  demoVisible  Boolean @default(false)

  headline            String
  urgency             String    // "act-now" | "this-week" | "monitor"
  momentSummary       String    @db.Text
  accelerationContext String    @db.Text
  contentAngles       Json      // { headline, description, example, platform }[]
  platformStrategy    Json      // { platform, approach, formats, tone }[]
  brandFit            Json      // { ideal_brands, warning_signals, engagement_window }

  velocityAtGeneration Int?

  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subculture Subculture @relation(fields: [subcultureId], references: [id])

  @@index([userId])
  @@index([subcultureId])
  @@index([createdAt])
}

// ─── Workspaces ───────────────────────────────────────────────────────────────
// Shared team environments for Agency-tier users. Each workspace can have
// custom branding (white-label) and invite team members or clients.

model Workspace {
  id      String @id @default(cuid())
  name    String
  slug    String @unique
  ownerId String

  // White-label branding
  brandName    String?
  brandLogo    String? // URL to uploaded logo
  brandColor   String? @default("#3b82f6") // hex primary color
  customDomain String? @unique // e.g. "insights.clientname.com"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members WorkspaceMember[]
  invites WorkspaceInvite[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String @id @default(cuid())
  workspaceId String
  userId      String
  role        String @default("member") // owner | admin | member
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String @id @default(cuid())
  workspaceId String
  email       String
  role        String @default("member")
  token       String @unique @default(cuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([token])
}

// ─── Audience Audit Log ───────────────────────────────────────────────────────
// Every brand audit run is saved here for admin review and history.

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  handle    String
  platform  String
  result    Json     // full BrandAuditResult
  // Demo curation — admin toggles which audit runs appear in the demo sync
  demoVisible Boolean @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([handle])
  @@index([createdAt])
}

model MonitorSnapshot {
  id         String   @id @default(cuid())
  monitorId  String
  platform   String   // reddit | twitter | tiktok | youtube | instagram | trends
  postCount  Int
  engagement Int
  topPosts   Json     // { title, url, score, comments? }[]
  capturedAt DateTime @default(now())

  monitor    Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId])
  @@index([capturedAt])
}
